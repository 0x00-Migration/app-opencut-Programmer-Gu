{
  "$schema": "./acde.config.schema.json",
  // OpenCut (opencut-app/opencut-classic, MIT), the browser video editor, as a Dopame window app.
  // acdev recognizes Next.js from the dependencies and runs `next build` (output: "standalone"); the standalone server
  // becomes the app backend and serves the pages, so there is no `entry`.
  "type": "app",
  "id": "opencut",
  "label": "OpenCut",
  "icon": "video-x-generic",
  "framework": "next",
  // Video editing holds decoded frames and audio buffers in the page; the default 256 MB heap is too small.
  "heapMb": 4096,
  "capabilities": {},
  "optional": [],
  "services": [],
  "requests": [],
  "schemes": []
}
